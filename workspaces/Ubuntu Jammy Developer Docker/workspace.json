{
  "description": "Ubuntu is a Linux distribution based on Debian. It is configured for Docker development.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop",
    "Productivity",
    "Development"
  ],
  "friendly_name": "Ubuntu Jammy - Docker Developer",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "lathanaspa/kasm-ubuntu-jammy-docker:develop",
      "uncompressed_size_mb": 2170,
      "available_tags": [
        "develop"
      ]
    }
  ]
}